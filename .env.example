# ==============================================================================
# Kings LMS Environment Variables Template
# ==============================================================================
# Instructions:
# Copy this file to .env.local and fill in the values below.
# DO NOT commit .env.local to version control!

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Auth)
# ------------------------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# ------------------------------------------------------------------------------
# 3. AI Assistant Configuration (Gemini & IBM Bob)
# ------------------------------------------------------------------------------
# Required for the study assistant (IBM Bob API Key or Gemini API Key):
IBM_BOB_API_KEY="your_ibm_bob_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Required for BOB client-side context (if using client-side GenAI directly):
NEXT_PUBLIC_GOOGLE_GENAI_API_KEY="your_api_key_here"

# ------------------------------------------------------------------------------
# 4. Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
# Generate these by running: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:admin@kingsedu.ac.in"

# ------------------------------------------------------------------------------
# 5. External Services
# ------------------------------------------------------------------------------
# Email sending service (Resend)
RESEND_API_KEY="your_resend_api_key_here"

# Map tiles for IV Tracker (Leave blank for default OpenStreetMap)
NEXT_PUBLIC_ESRI_TILES=""
