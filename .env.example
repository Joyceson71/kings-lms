# Supabase Project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon key — safe to expose in client
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Supabase Service Role key — NEVER expose publicly
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IBM watsonx Assistant (Bob)
NEXT_PUBLIC_IBM_BOB_INTEGRATION_ID="your_integration_id_from_ibm_cloud"
NEXT_PUBLIC_IBM_BOB_REGION="us-south"
NEXT_PUBLIC_IBM_BOB_SERVICE_INSTANCE_ID="your_service_instance_id"

NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT=""
NEXT_PUBLIC_ESRI_TILES=""
RESEND_API_KEY="[ENCRYPTION_KEY]"
